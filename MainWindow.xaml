<Window x:Class="MCServerManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MC Server Manager"
        Height="760"
        Width="1220"
        MinHeight="660"
        MinWidth="1060"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        FontSize="13"
        Background="{DynamicResource Brush.AppBackground}"
        Foreground="{DynamicResource Brush.TextPrimary}">

    <!-- ================================================================
         Оформление: всё в Themes/ (стили + палитры).
         Имена контролов и обработчики событий — прежние, поэтому
         MainWindow.xaml.cs работает без изменений.
         ================================================================ -->

    <Grid Background="{DynamicResource Brush.AppBackground}">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>


        <!-- ==================== Левая панель ==================== -->

        <Border Grid.Column="0"
                Background="{DynamicResource Brush.SidebarBackground}"
                BorderBrush="{DynamicResource Brush.Separator}"
                BorderThickness="0,0,1,0">

            <Grid Margin="16,18,16,16">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>


                <StackPanel Grid.Row="0"
                            Margin="0,0,0,18">

                    <TextBlock Text="MC Server Manager"
                               FontSize="19"
                               FontWeight="Bold" />

                    <TextBlock Text="Minecraft и Terraria"
                               Style="{StaticResource HintText}"
                               Margin="0,2,0,0" />

                </StackPanel>


                <TextBlock Grid.Row="1"
                           Text="ИГРА"
                           Style="{StaticResource SectionCaption}" />


                <Grid Grid.Row="2"
                      Margin="0,0,0,4">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button x:Name="MinecraftGameButton"
                            Grid.Column="0"
                            Content="🟩 Minecraft"
                            Height="36"
                            Margin="0,0,5,0"
                            Click="SelectGameMinecraft_Click" />

                    <Button x:Name="TerrariaGameButton"
                            Grid.Column="1"
                            Content="🍄 Terraria"
                            Height="36"
                            Margin="5,0,0,0"
                            Click="SelectGameTerraria_Click" />

                </Grid>


                <TextBlock Grid.Row="3"
                           Text="Серверы"
                           FontSize="18"
                           FontWeight="Bold"
                           Margin="0,12,0,8" />


                <ListBox x:Name="ServersListBox"
                         Grid.Row="4"
                         SelectionChanged="ServersListBox_SelectionChanged" />


                <TextBox x:Name="ServerNameBox"
                         Grid.Row="5"
                         Margin="0,12,0,0"
                         Text="Название сервера" />


                <Button Grid.Row="6"
                        Content="➕ Создать сервер"
                        Height="36"
                        Margin="0,8,0,0"
                        Click="CreateServer_Click" />


                <Button Grid.Row="7"
                        Content="🗑 Удалить сервер"
                        Style="{StaticResource DangerButton}"
                        Height="36"
                        Margin="0,8,0,0"
                        Click="DeleteServer_Click" />


                <Button x:Name="ThemeToggleButton"
                        Grid.Row="8"
                        Content="🌙 Тёмная тема"
                        Height="34"
                        Margin="0,16,0,0"
                        Click="ToggleTheme_Click" />

            </Grid>

        </Border>


        <!-- ==================== Правая часть ==================== -->

        <Grid Grid.Column="1"
              Margin="22,18,22,18">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>


            <TextBlock x:Name="ServerTitle"
                       Grid.Row="0"
                       Text="Сервер не выбран"
                       FontSize="24"
                       FontWeight="Bold" />


            <!-- ====== Кнопки управления ====== -->

            <Grid Grid.Row="1"
                  Margin="0,14,0,0">

                <!-- Minecraft -->
                <StackPanel x:Name="MinecraftControlsPanel">

                    <Border Style="{StaticResource Card}">
                        <WrapPanel>

                            <Button Content="▶ Запустить"
                                    Style="{StaticResource AccentButton}"
                                    Height="38"
                                    MinWidth="134"
                                    Margin="0,0,8,8"
                                    Click="StartServer_Click" />

                            <Button Content="■ Остановить"
                                    Style="{StaticResource DangerButton}"
                                    Height="38"
                                    MinWidth="134"
                                    Margin="0,0,8,8"
                                    Click="StopServer_Click" />

                            <Button Content="↻ Перезапуск"
                                    Height="38"
                                    MinWidth="134"
                                    Margin="0,0,8,8"
                                    Click="RestartServer_Click" />

                            <Button Content="👥 Управление"
                                    Height="38"
                                    MinWidth="134"
                                    Margin="0,0,8,8"
                                    Click="OpenServerWindow_Click" />

                            <Button Content="📂 Папка"
                                    Height="38"
                                    MinWidth="110"
                                    Margin="0,0,8,8"
                                    Click="OpenFolder_Click" />

                        </WrapPanel>
                    </Border>


                    <Border Style="{StaticResource Card}"
                            Margin="0,10,0,0">
                        <WrapPanel>

                            <TextBlock Text="Ядро:"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,8" />

                            <ComboBox x:Name="CoreComboBox"
                                      Width="124"
                                      Margin="0,0,14,8"
                                      SelectedIndex="0"
                                      SelectionChanged="CoreComboBox_SelectionChanged">

                                <ComboBoxItem Content="Paper" />
                                <ComboBoxItem Content="Purpur" />
                                <ComboBoxItem Content="Bukkit" />
                                <ComboBoxItem Content="Fabric" />
                                <ComboBoxItem Content="Forge" />
                                <ComboBoxItem Content="NeoForge" />
                                <ComboBoxItem Content="Vanilla" />

                            </ComboBox>


                            <TextBlock Text="Версия:"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,8" />

                            <ComboBox x:Name="CoreVersionBox"
                                      Width="124"
                                      Margin="0,0,6,8"
                                      IsEditable="True" />

                            <Button x:Name="RefreshVersionsButton"
                                    Content="🔄"
                                    Width="42"
                                    Height="32"
                                    Margin="0,0,14,8"
                                    ToolTip="Обновить список версий"
                                    Click="RefreshVersions_Click" />

                            <Button x:Name="InstallCoreButton"
                                    Content="Установить ядро"
                                    Height="32"
                                    Margin="0,0,8,8"
                                    Click="InstallCore_Click" />

                            <Button x:Name="ModsPluginsButton"
                                    Content="📦 Моды и плагины"
                                    Height="32"
                                    Margin="0,0,8,8"
                                    Click="ModsPlugins_Click" />

                            <CheckBox x:Name="McAutoRestartCheckBox"
                                      Content="🔁 Автоперезапуск при краше"
                                      VerticalAlignment="Center"
                                      Margin="0,0,0,8" />

                        </WrapPanel>
                    </Border>

                </StackPanel>


                <!-- Terraria -->
                <StackPanel x:Name="TerrariaControlsPanel"
                            Visibility="Collapsed">

                    <Border Style="{StaticResource Card}">
                        <WrapPanel>

                            <Button Content="▶ Запустить"
                                    Style="{StaticResource AccentButton}"
                                    Height="38"
                                    MinWidth="134"
                                    Margin="0,0,8,8"
                                    Click="StartTerrariaServer_Click" />

                            <Button Content="■ Остановить"
                                    Style="{StaticResource DangerButton}"
                                    Height="38"
                                    MinWidth="134"
                                    Margin="0,0,8,8"
                                    Click="StopTerrariaServer_Click" />

                            <Button Content="📂 Папка"
                                    Height="38"
                                    MinWidth="110"
                                    Margin="0,0,8,8"
                                    Click="OpenTerrariaFolder_Click" />

                            <Button Content="🗑 Удалить"
                                    Style="{StaticResource DangerButton}"
                                    Height="38"
                                    MinWidth="110"
                                    Margin="0,0,8,8"
                                    Click="DeleteTerrariaServer_Click" />

                        </WrapPanel>
                    </Border>


                    <Border Style="{StaticResource Card}"
                            Margin="0,10,0,0">
                        <WrapPanel>

                            <TextBlock Text="Движок:"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,8" />

                            <ComboBox x:Name="TerrariaCoreBox"
                                      Width="130"
                                      Margin="0,0,14,8"
                                      SelectedIndex="0"
                                      SelectionChanged="TerrariaCoreBox_SelectionChanged">

                                <ComboBoxItem Content="TShock" />
                                <ComboBoxItem Content="tModLoader" />

                            </ComboBox>


                            <TextBlock Text="Версия:"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,8" />

                            <ComboBox x:Name="TShockVersionBox"
                                      Width="150"
                                      Margin="0,0,6,8"
                                      IsEditable="True" />

                            <Button x:Name="RefreshTShockVersionsButton"
                                    Content="🔄"
                                    Width="42"
                                    Height="32"
                                    Margin="0,0,14,8"
                                    Click="RefreshTShockVersions_Click" />

                            <Button x:Name="InstallTShockButton"
                                    Content="Установить TShock"
                                    Height="32"
                                    Margin="0,0,8,8"
                                    Click="InstallTShock_Click" />

                            <CheckBox x:Name="TrAutoRestartCheckBox"
                                      Content="🔁 Автоперезапуск при краше"
                                      VerticalAlignment="Center"
                                      Margin="0,0,0,8" />

                        </WrapPanel>
                    </Border>


                    <TextBlock Text="Настройки порта, игроков, пароля и мира — во вкладке «Настройки»."
                               Style="{StaticResource HintText}"
                               Margin="2,8,0,0" />

                </StackPanel>

            </Grid>


            <TextBlock x:Name="CoreSupportText"
                       Grid.Row="2"
                       Text=""
                       Style="{StaticResource HintText}"
                       Margin="2,8,0,0" />


            <!-- ====== Вкладки ====== -->

            <TabControl x:Name="MainTabControl"
                        Grid.Row="3"
                        Margin="0,14,0,0">


                <!-- ===================== КОНСОЛЬ ===================== -->

                <TabItem Header="Консоль">

                    <TextBox x:Name="ConsoleBox"
                             Style="{StaticResource ConsoleTextBox}" />

                </TabItem>


                <!-- ===================== ИНФОРМАЦИЯ (MINECRAFT) ===================== -->

                <TabItem x:Name="MinecraftInfoTab"
                         Header="Информация">

                    <ScrollViewer VerticalScrollBarVisibility="Auto">

                        <StackPanel MaxWidth="620"
                                    HorizontalAlignment="Left">

                            <TextBlock x:Name="InfoStatusText"
                                       Text="🔴 Остановлен"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Margin="0,0,0,12" />


                            <Border Style="{StaticResource Card}">

                                <StackPanel>

                                    <TextBlock Text="Адрес для тебя (этот же компьютер)"
                                               Style="{StaticResource CardTitle}" />

                                    <TextBox x:Name="InfoLocalIpBox"
                                             Style="{StaticResource InfoBox}"
                                             Text="localhost:25565" />


                                    <TextBlock Text="Адрес для друзей (через интернет)"
                                               Style="{StaticResource FieldLabel}" />

                                    <DockPanel>

                                        <Button Content="🔄"
                                                DockPanel.Dock="Right"
                                                Width="42"
                                                Margin="8,0,0,0"
                                                ToolTip="Обновить внешний IP"
                                                Click="RefreshPublicIp_Click" />

                                        <TextBox x:Name="InfoPublicIpBox"
                                                 Style="{StaticResource InfoBox}"
                                                 Text="определяется..." />

                                    </DockPanel>

                                    <TextBlock Text="Чтобы друзья зашли через интернет, пробрось порт сервера на роутере."
                                               Style="{StaticResource HintText}" />

                                </StackPanel>

                            </Border>


                            <Border Style="{StaticResource Card}"
                                    Margin="0,10,0,0">

                                <StackPanel>

                                    <TextBlock Text="Сервер"
                                               Style="{StaticResource CardTitle}" />

                                    <TextBlock Text="Версия"
                                               Style="{StaticResource FieldLabel}"
                                               Margin="0,0,0,4" />

                                    <TextBox x:Name="InfoVersionBox"
                                             Style="{StaticResource InfoBox}" />


                                    <TextBlock Text="Ядро"
                                               Style="{StaticResource FieldLabel}" />

                                    <TextBox x:Name="InfoCoreBox"
                                             Style="{StaticResource InfoBox}" />


                                    <TextBlock Text="Домен (если куплен)"
                                               Style="{StaticResource FieldLabel}" />

                                    <DockPanel>

                                        <Button Content="Сохранить"
                                                DockPanel.Dock="Right"
                                                Width="110"
                                                Margin="8,0,0,0"
                                                Click="SaveDomain_Click" />

                                        <TextBox x:Name="InfoDomainBox" />

                                    </DockPanel>

                                    <TextBlock Text="Направь A-запись домена у регистратора на внешний IP выше — программа домен не покупает и DNS не настраивает."
                                               Style="{StaticResource HintText}" />

                                </StackPanel>

                            </Border>


                            <Border Style="{StaticResource Card}"
                                    Margin="0,10,0,0">

                                <StackPanel>

                                    <TextBlock Text="Мир"
                                               Style="{StaticResource CardTitle}" />

                                    <TextBlock Text="Перед скачиванием или загрузкой мира сервер нужно остановить."
                                               Style="{StaticResource HintText}"
                                               Margin="0,0,0,10" />

                                    <WrapPanel>

                                        <Button Content="📥 Скачать мир"
                                                Height="36"
                                                MinWidth="150"
                                                Margin="0,0,8,8"
                                                Click="DownloadWorld_Click" />

                                        <Button Content="📤 Загрузить мир"
                                                Height="36"
                                                MinWidth="150"
                                                Margin="0,0,8,8"
                                                Click="UploadWorld_Click" />

                                    </WrapPanel>

                                </StackPanel>

                            </Border>

                        </StackPanel>

                    </ScrollViewer>

                </TabItem>


                <!-- ===================== ИНФОРМАЦИЯ (TERRARIA) ===================== -->

                <TabItem x:Name="TerrariaInfoTab"
                         Header="Информация"
                         Visibility="Collapsed">

                    <ScrollViewer VerticalScrollBarVisibility="Auto">

                        <StackPanel MaxWidth="620"
                                    HorizontalAlignment="Left">

                            <TextBlock x:Name="TerrariaInfoStatusText"
                                       Text="🔴 Остановлен"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Margin="0,0,0,12" />


                            <Border Style="{StaticResource Card}">

                                <StackPanel>

                                    <TextBlock Text="Адрес для тебя (этот же компьютер)"
                                               Style="{StaticResource CardTitle}" />

                                    <TextBox x:Name="TerrariaInfoLocalIpBox"
                                             Style="{StaticResource InfoBox}"
                                             Text="localhost:7777" />


                                    <TextBlock Text="Адрес для друзей (через интернет)"
                                               Style="{StaticResource FieldLabel}" />

                                    <DockPanel>

                                        <Button Content="🔄"
                                                DockPanel.Dock="Right"
                                                Width="42"
                                                Margin="8,0,0,0"
                                                ToolTip="Обновить внешний IP"
                                                Click="RefreshTerrariaPublicIp_Click" />

                                        <TextBox x:Name="TerrariaInfoPublicIpBox"
                                                 Style="{StaticResource InfoBox}"
                                                 Text="определяется..." />

                                    </DockPanel>

                                    <TextBlock Text="Друзьям нужно пробросить этот порт на роутере. Игроки с телефона (Terraria 1.4+) заходят так же — кроссплей работает."
                                               Style="{StaticResource HintText}" />

                                </StackPanel>

                            </Border>


                            <Border Style="{StaticResource Card}"
                                    Margin="0,10,0,0">

                                <StackPanel>

                                    <TextBlock Text="Сервер"
                                               Style="{StaticResource CardTitle}" />

                                    <TextBlock Text="TShock"
                                               Style="{StaticResource FieldLabel}"
                                               Margin="0,0,0,4" />

                                    <TextBox x:Name="TerrariaInfoVersionBox"
                                             Style="{StaticResource InfoBox}" />

                                </StackPanel>

                            </Border>


                            <Border Style="{StaticResource Card}"
                                    Margin="0,10,0,0">

                                <StackPanel>

                                    <TextBlock Text="Игроки онлайн"
                                               Style="{StaticResource CardTitle}" />

                                    <ListBox x:Name="TerrariaPlayersListBox"
                                             Height="140" />

                                    <WrapPanel Margin="0,8,0,0">

                                        <Button Content="Кик"
                                                MinWidth="110"
                                                Height="34"
                                                Margin="0,0,8,0"
                                                Click="TerrariaKick_Click" />

                                        <Button Content="Бан"
                                                Style="{StaticResource DangerButton}"
                                                MinWidth="110"
                                                Height="34"
                                                Click="TerrariaBan_Click" />

                                    </WrapPanel>

                                </StackPanel>

                            </Border>


                            <Border Style="{StaticResource Card}"
                                    Margin="0,10,0,0">

                                <StackPanel>

                                    <TextBlock Text="Мир"
                                               Style="{StaticResource CardTitle}" />

                                    <TextBlock Text="Перед скачиванием или загрузкой мира сервер нужно остановить. Мир Terraria — один файл .wld, не папка."
                                               Style="{StaticResource HintText}"
                                               Margin="0,0,0,10" />

                                    <WrapPanel>

                                        <Button Content="📥 Скачать мир"
                                                Height="36"
                                                MinWidth="150"
                                                Margin="0,0,8,8"
                                                Click="DownloadTerrariaWorld_Click" />

                                        <Button Content="📤 Загрузить мир"
                                                Height="36"
                                                MinWidth="150"
                                                Margin="0,0,8,8"
                                                Click="UploadTerrariaWorld_Click" />

                                    </WrapPanel>

                                </StackPanel>

                            </Border>

                        </StackPanel>

                    </ScrollViewer>

                </TabItem>


                <!-- ===================== НАСТРОЙКИ (MINECRAFT) ===================== -->

                <TabItem x:Name="MinecraftSettingsTab"
                         Header="Настройки">

                    <ScrollViewer VerticalScrollBarVisibility="Auto">

                        <StackPanel MaxWidth="620"
                                    HorizontalAlignment="Left">


                            <Border Style="{StaticResource Card}">

                                <StackPanel>

                                    <TextBlock Text="Название"
                                               Style="{StaticResource CardTitle}" />

                                    <DockPanel>

                                        <Button Content="Переименовать"
                                                DockPanel.Dock="Right"
                                                Width="150"
                                                Margin="8,0,0,0"
                                                Click="RenameServer_Click" />

                                        <TextBox x:Name="SettingsNameBox" />

                                    </DockPanel>

                                </StackPanel>

                            </Border>


                            <Border Style="{StaticResource Card}"
                                    Margin="0,10,0,0">

                                <StackPanel>

                                    <TextBlock Text="Производительность и лаги"
                                               Style="{StaticResource CardTitle}" />

                                    <TextBlock Text="Дистанция прорисовки чанков (view-distance)"
                                               Style="{StaticResource FieldLabel}"
                                               Margin="0,0,0,4" />

                                    <TextBox x:Name="SettingsViewDistanceBox" />


                                    <TextBlock Text="Дальность симуляции (simulation-distance)"
                                               Style="{StaticResource FieldLabel}" />

                                    <TextBox x:Name="SettingsSimulationDistanceBox" />


                                    <TextBlock Text="Максимум игроков (max-players)"
                                               Style="{StaticResource FieldLabel}" />

                                    <TextBox x:Name="SettingsMaxPlayersBox" />

                                    <TextBlock Text="Чем меньше дистанции — тем легче серверу. Если игроки жалуются на лаги, начни с view-distance 8 и simulation-distance 6."
                                               Style="{StaticResource HintText}" />

                                </StackPanel>

                            </Border>


                            <Border Style="{StaticResource Card}"
                                    Margin="0,10,0,0">

                                <StackPanel>

                                    <TextBlock Text="Мир и правила"
                                               Style="{StaticResource CardTitle}" />

                                    <TextBlock Text="Сложность"
                                               Style="{StaticResource FieldLabel}"
                                               Margin="0,0,0,4" />

                                    <ComboBox x:Name="SettingsDifficultyCombo">

                                        <ComboBoxItem Content="Мирная" Tag="peaceful" />
                                        <ComboBoxItem Content="Лёгкая" Tag="easy" />
                                        <ComboBoxItem Content="Средняя" Tag="normal" />
                                        <ComboBoxItem Content="Сложная" Tag="hard" />

                                    </ComboBox>


                                    <TextBlock Text="Сид мира (level-seed)"
                                               Style="{StaticResource FieldLabel}" />

                                    <TextBox x:Name="SettingsSeedBox" />

                                    <TextBlock Text="Пустое поле — случайный сид. Меняется только для НОВОГО мира, на уже созданный не влияет."
                                               Style="{StaticResource HintText}" />


                                    <CheckBox x:Name="SettingsPvpCheckBox"
                                              Content="PvP включён (игроки могут бить друг друга)"
                                              Margin="0,16,0,0" />

                                </StackPanel>

                            </Border>


                            <Border Style="{StaticResource Card}"
                                    Margin="0,10,0,0">

                                <StackPanel>

                                    <TextBlock Text="Доступ игроков"
                                               Style="{StaticResource CardTitle}" />

                                    <CheckBox x:Name="SettingsPirateCheckBox"
                                              Content="Пиратский сервер (offline-mode)" />

                                    <TextBlock Text="Выключено — заходить смогут только лицензионные копии игры."
                                               Style="{StaticResource HintText}" />

                                </StackPanel>

                            </Border>


                            <Button Content="💾 Сохранить настройки"
                                    Style="{StaticResource AccentButton}"
                                    Height="38"
                                    Margin="0,14,0,0"
                                    Click="SaveSettings_Click" />

                            <TextBlock x:Name="SettingsHintText"
                                       Text="Некоторые настройки применяются только после перезапуска сервера."
                                       Style="{StaticResource HintText}" />

                        </StackPanel>

                    </ScrollViewer>

                </TabItem>


                <!-- ===================== НАСТРОЙКИ (TERRARIA) ===================== -->

                <TabItem x:Name="TerrariaSettingsTab"
                         Header="Настройки"
                         Visibility="Collapsed">

                    <ScrollViewer VerticalScrollBarVisibility="Auto">

                        <StackPanel MaxWidth="620"
                                    HorizontalAlignment="Left">


                            <Border Style="{StaticResource Card}">

                                <StackPanel>

                                    <TextBlock Text="Сервер"
                                               Style="{StaticResource CardTitle}" />

                                    <TextBlock Text="Порт"
                                               Style="{StaticResource FieldLabel}"
                                               Margin="0,0,0,4" />

                                    <TextBox x:Name="TerrariaPortBox" />


                                    <TextBlock Text="Максимум игроков"
                                               Style="{StaticResource FieldLabel}" />

                                    <TextBox x:Name="TerrariaMaxPlayersBox" />


                                    <TextBlock Text="Пароль (пусто — без пароля)"
                                               Style="{StaticResource FieldLabel}" />

                                    <TextBox x:Name="TerrariaPasswordBox" />

                                </StackPanel>

                            </Border>


                            <Border Style="{StaticResource Card}"
                                    Margin="0,10,0,0">

                                <StackPanel>

                                    <TextBlock Text="Новый мир"
                                               Style="{StaticResource CardTitle}" />

                                    <TextBlock Text="Размер мира"
                                               Style="{StaticResource FieldLabel}"
                                               Margin="0,0,0,4" />

                                    <ComboBox x:Name="TerrariaWorldSizeBox">
                                        <ComboBoxItem Content="Маленький" Tag="1" />
                                        <ComboBoxItem Content="Средний" Tag="2" />
                                        <ComboBoxItem Content="Большой" Tag="3" />
                                    </ComboBox>


                                    <TextBlock Text="Сложность"
                                               Style="{StaticResource FieldLabel}" />

                                    <ComboBox x:Name="TerrariaDifficultyBox">
                                        <ComboBoxItem Content="Обычная" Tag="0" />
                                        <ComboBoxItem Content="Эксперт" Tag="1" />
                                        <ComboBoxItem Content="Мастер" Tag="2" />
                                        <ComboBoxItem Content="Путешествие" Tag="3" />
                                    </ComboBox>

                                    <TextBlock Text="Размер и сложность применяются только при создании НОВОГО мира. Остальное — после перезапуска сервера."
                                               Style="{StaticResource HintText}" />

                                </StackPanel>

                            </Border>


                            <Button Content="💾 Сохранить настройки"
                                    Style="{StaticResource AccentButton}"
                                    Height="38"
                                    Margin="0,14,0,0"
                                    Click="SaveTerrariaSettings_Click" />

                        </StackPanel>

                    </ScrollViewer>

                </TabItem>


                <!-- ===================== ДОСТУП ===================== -->

                <TabItem x:Name="AccessTab"
                         Header="Доступ">

                    <ScrollViewer VerticalScrollBarVisibility="Auto">

                        <StackPanel MaxWidth="620"
                                    HorizontalAlignment="Left">


                            <Border Style="{StaticResource Card}">

                                <StackPanel>

                                    <TextBlock Text="Дать другу доступ к серверу"
                                               Style="{StaticResource CardTitle}" />

                                    <TextBlock Text="Работает, только пока приложение запущено на твоём ПК. Друг сможет управлять сервером так же, как ты: старт и стоп, консоль, кик, бан, whitelist."
                                               Style="{StaticResource HintText}"
                                               Margin="0,0,0,4" />


                                    <TextBlock Text="Порт для подключения"
                                               Style="{StaticResource FieldLabel}" />

                                    <TextBox x:Name="HostPortBox"
                                             Text="5001" />


                                    <TextBlock Text="Пароль для друга"
                                               Style="{StaticResource FieldLabel}" />

                                    <TextBox x:Name="HostPasswordBox" />


                                    <Button x:Name="ToggleHostButton"
                                            Content="Открыть доступ"
                                            Style="{StaticResource AccentButton}"
                                            Height="38"
                                            Margin="0,14,0,0"
                                            Click="ToggleHost_Click" />


                                    <TextBlock x:Name="HostStatusText"
                                               Text="Доступ закрыт"
                                               FontWeight="Bold"
                                               Margin="0,10,0,0" />

                                    <TextBlock Text="Другу нужно знать твой внешний IP и пробросить этот порт на роутере — так же, как игровой порт 25565."
                                               Style="{StaticResource HintText}" />

                                </StackPanel>

                            </Border>


                            <Border Style="{StaticResource Card}"
                                    Margin="0,10,0,0">

                                <StackPanel>

                                    <TextBlock Text="Подключиться к серверу друга"
                                               Style="{StaticResource CardTitle}" />

                                    <TextBlock Text="IP или адрес друга"
                                               Style="{StaticResource FieldLabel}"
                                               Margin="0,0,0,4" />

                                    <TextBox x:Name="ConnectHostBox" />


                                    <TextBlock Text="Порт"
                                               Style="{StaticResource FieldLabel}" />

                                    <TextBox x:Name="ConnectPortBox"
                                             Text="5001" />


                                    <TextBlock Text="Пароль"
                                               Style="{StaticResource FieldLabel}" />

                                    <TextBox x:Name="ConnectPasswordBox" />


                                    <Button Content="Подключиться"
                                            Style="{StaticResource AccentButton}"
                                            Height="38"
                                            Margin="0,14,0,0"
                                            Click="ConnectToFriend_Click" />

                                </StackPanel>

                            </Border>

                        </StackPanel>

                    </ScrollViewer>

                </TabItem>

            </TabControl>

        </Grid>

    </Grid>

</Window>
