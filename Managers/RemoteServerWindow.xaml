<Window x:Class="MCServerManager.RemoteServerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Удалённое управление"
        Height="780"
        Width="1080"
        MinHeight="620"
        MinWidth="900"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI"
        FontSize="13"
        Background="{DynamicResource Brush.AppBackground}"
        Foreground="{DynamicResource Brush.TextPrimary}">

    <Grid Background="{DynamicResource Brush.AppBackground}">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="320" />
        </Grid.ColumnDefinitions>


        <!-- ==================== Левая часть: статус и консоль ==================== -->

        <Grid Grid.Column="0"
              Margin="18,16,10,16">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>


            <TextBlock x:Name="ConnectionStatusText"
                       Grid.Row="0"
                       Text="Подключение..."
                       FontSize="17"
                       FontWeight="Bold"
                       Margin="0,0,0,12" />


            <Border Grid.Row="1"
                    Style="{StaticResource Card}"
                    Padding="0">

                <TextBox x:Name="ConsoleOutput"
                         Style="{StaticResource ConsoleTextBox}"
                         FontSize="14"
                         IsReadOnly="True"
                         BorderThickness="0"
                         Margin="1" />

            </Border>


            <DockPanel Grid.Row="2"
                       Margin="0,12,0,0">

                <Button Content="Отправить"
                        DockPanel.Dock="Right"
                        Width="130"
                        Margin="8,0,0,0"
                        Click="SendCommand_Click" />

                <TextBox x:Name="CommandBox"
                         VerticalAlignment="Center" />

            </DockPanel>


            <WrapPanel Grid.Row="3"
                       Margin="0,12,0,0">

                <Button Content="▶ Запустить"
                        Style="{StaticResource AccentButton}"
                        Height="38"
                        MinWidth="150"
                        Margin="0,0,8,0"
                        Click="StartServer_Click" />

                <Button Content="■ Остановить"
                        Style="{StaticResource DangerButton}"
                        Height="38"
                        MinWidth="150"
                        Click="StopServer_Click" />

            </WrapPanel>

        </Grid>


        <!-- ==================== Правая часть ==================== -->

        <Border Grid.Column="1"
                Background="{DynamicResource Brush.SidebarBackground}"
                BorderBrush="{DynamicResource Brush.Separator}"
                BorderThickness="1,0,0,0">

            <ScrollViewer VerticalScrollBarVisibility="Auto">

                <StackPanel Margin="16">


                    <Border Style="{StaticResource Card}">

                        <StackPanel>

                            <TextBlock Text="Игроки онлайн"
                                       Style="{StaticResource CardTitle}" />

                            <ListBox x:Name="PlayersListBox"
                                     Height="170" />

                            <StackPanel Margin="0,10,0,0">

                                <Button Content="Кик"
                                        Height="34"
                                        MinWidth="130"
                                        Margin="0,0,0,6"
                                        Click="Kick_Click" />

                                <Button Content="Бан"
                                        Style="{StaticResource DangerButton}"
                                        Height="34"
                                        MinWidth="130"
                                        Margin="0,0,0,6"
                                        Click="Ban_Click" />

                                <Button Content="Выдать OP"
                                        Height="34"
                                        MinWidth="130"
                                        Margin="0,0,0,6"
                                        Click="Op_Click" />

                                <Button Content="Снять OP"
                                        Height="34"
                                        MinWidth="130"
                                        Margin="0,0,0,6"
                                        Click="Deop_Click" />

                                <Button Content="🔄 Обновить"
                                        Height="34"
                                        MinWidth="130"
                                        Margin="0,0,0,6"
                                        Click="RefreshPlayers_Click" />

                            </StackPanel>

                        </StackPanel>

                    </Border>


                    <Border Style="{StaticResource Card}"
                            Margin="0,10,0,0">

                        <StackPanel>

                            <TextBlock Text="Белый список"
                                       Style="{StaticResource CardTitle}" />

                            <WrapPanel>

                                <Button Content="Whitelist ON"
                                        Height="34"
                                        MinWidth="130"
                                        Margin="0,0,8,8"
                                        Click="WhitelistOn_Click" />

                                <Button Content="Whitelist OFF"
                                        Height="34"
                                        MinWidth="130"
                                        Margin="0,0,8,8"
                                        Click="WhitelistOff_Click" />

                            </WrapPanel>

                            <ListBox x:Name="WhitelistListBox"
                                     Height="110" />

                            <TextBox x:Name="WhitelistNameBox"
                                     Margin="0,10,0,0" />

                            <StackPanel Margin="0,10,0,0">

                                <Button Content="Добавить"
                                        Height="34"
                                        MinWidth="130"
                                        Margin="0,0,0,6"
                                        Click="WhitelistAdd_Click" />

                                <Button Content="Удалить"
                                        Style="{StaticResource DangerButton}"
                                        Height="34"
                                        MinWidth="130"
                                        Margin="0,0,0,6"
                                        Click="WhitelistRemove_Click" />

                            </StackPanel>

                        </StackPanel>

                    </Border>


                    <Border Style="{StaticResource Card}"
                            Margin="0,10,0,0">

                        <StackPanel>

                            <TextBlock Text="Забаненные"
                                       Style="{StaticResource CardTitle}" />

                            <ListBox x:Name="BannedListBox"
                                     Height="110" />

                            <Button Content="Разбан"
                                    Height="34"
                                    Margin="0,10,0,0"
                                    Click="Unban_Click" />

                        </StackPanel>

                    </Border>

                </StackPanel>

            </ScrollViewer>

        </Border>

    </Grid>

</Window>
