<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================
         СВЕТЛАЯ ТЕМА — только цвета.
         Те же ключи обязаны быть в Themes/Dark.xaml.
         ============================================================ -->

    <SolidColorBrush x:Key="Brush.AppBackground" Color="#F3F5F9" />
    <SolidColorBrush x:Key="Brush.SidebarBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.CardBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.ControlBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.ControlHoverBackground" Color="#EEF3FB" />
    <SolidColorBrush x:Key="Brush.ControlPressedBackground" Color="#E1E9F6" />
    <SolidColorBrush x:Key="Brush.ControlBorder" Color="#D7DDE7" />
    <SolidColorBrush x:Key="Brush.ControlBorderHover" Color="#B6C1D2" />
    <SolidColorBrush x:Key="Brush.ReadOnlyBackground" Color="#F7F9FC" />

    <SolidColorBrush x:Key="Brush.TextPrimary" Color="#1E2430" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="#68717F" />

    <SolidColorBrush x:Key="Brush.Accent" Color="#2F6BEA" />
    <SolidColorBrush x:Key="Brush.AccentHover" Color="#4A82F2" />
    <SolidColorBrush x:Key="Brush.AccentPressed" Color="#2357C4" />
    <SolidColorBrush x:Key="Brush.AccentText" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.AccentSoft" Color="#E4EDFF" />

    <SolidColorBrush x:Key="Brush.Danger" Color="#D04545" />
    <SolidColorBrush x:Key="Brush.DangerSoft" Color="#FDECEC" />
    <SolidColorBrush x:Key="Brush.DangerBorder" Color="#F2C6C6" />
    <SolidColorBrush x:Key="Brush.Success" Color="#2E9E5B" />

    <SolidColorBrush x:Key="Brush.ConsoleBackground" Color="#15181E" />
    <SolidColorBrush x:Key="Brush.ConsoleForeground" Color="#DDE2EA" />
    <SolidColorBrush x:Key="Brush.ConsoleBorder" Color="#D7DDE7" />

    <SolidColorBrush x:Key="Brush.Separator" Color="#E4E8EF" />
    <SolidColorBrush x:Key="Brush.ScrollThumb" Color="#C7CEDA" />
    <SolidColorBrush x:Key="Brush.ScrollThumbHover" Color="#A9B3C4" />
    <SolidColorBrush x:Key="Brush.TooltipBackground" Color="#2A303C" />

</ResourceDictionary>
